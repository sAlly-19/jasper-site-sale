rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.admin == true &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /site_config/landing_page {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Operational data is served only by the Cloudflare Worker and D1.
    match /licenses/{licenseId} {
      allow read, write: if false;
    }

    match /promotions/{promotionId} {
      allow read, write: if false;
    }

    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
