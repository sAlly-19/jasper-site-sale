# Configurações do Firebase JS SDK (Web & Mobile)
# Preencha com os dados do seu projeto Firebase em seu arquivo .env local (ignorado pelo git)
EXPO_PUBLIC_FIREBASE_API_KEY=SUA_FIREBASE_API_KEY_AQUI
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Worker API (use http://localhost:8787 during local development)
EXPO_PUBLIC_JASPER_API_URL=http://localhost:8787

# Firebase Admin SDK (somente scripts locais; nunca use EXPO_PUBLIC_)
FIREBASE_SERVICE_ACCOUNT_PATH=C:\\caminho\\seguro\\firebase-admin.json
